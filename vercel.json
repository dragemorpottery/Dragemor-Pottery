{
  "rewrites": [
    {
      "source": "/produkt/:id",
      "destination": "/api/products?seo=1&id=:id"
    },
    {
      "source": "/sitemap-produkte.xml",
      "destination": "/api/products?sitemap=1"
    }
  ],
  "functions": {
    "api/create-checkout-session.js": {
      "maxDuration": 60
    },
    "api/stripe-webhook.js": {
      "maxDuration": 60
    }
  }
}
